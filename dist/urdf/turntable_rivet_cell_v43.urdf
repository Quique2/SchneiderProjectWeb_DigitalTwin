  </link>


  <!-- Added mirrored limit-switch tower bases.
       Reference: lower-left corner of the main base plate. The external X face of the first base is placed 0.275 m from that corner in X+.
       Lower plate: 0.030 m X, 0.047 m Y, 0.003 m Z.
       Tower: starts from the lower-left corner of that plate, 0.020 m X, 0.030 m Y, 0.069 m total Z from the base zero.
       Top groove for switch: starts 0.003 m from one Y edge, leaves 0.003 m on the other Y edge, and cuts downward 0.003 m.
       The second assembly mirrors the original geometry; both added assemblies were then shifted +0.010 m in global Y.
       V28 adjustment: switch joint X = 0.017893 m aligns the switch lower-left X edge to the tower/top-base X edge; right switch Y = 0.242081 m gives a 0.010 m outer-edge gap.
       V29 adjustment: both switch joint Z values lowered by 0.003 m; the complete right-side assembly was shifted -0.020 m in Y.
       V38 adjustment: restored switch rotations from V37 but applied the requested -0.020 m global X shift to both complete external limit-switch assemblies. -->
  <joint name="base_to_limit_switch_base_left" type="fixed">
    <parent link="base_link"/>
    <child link="limit_switch_base_left_link"/>
    <origin xyz="0.005000 -0.216500 0.037500" rpy="0 0 0"/>
  </joint>

  <link name="limit_switch_base_left_link">
