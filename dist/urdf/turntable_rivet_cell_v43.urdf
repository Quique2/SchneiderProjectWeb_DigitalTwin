  <!-- CAFI drop/grasp frame for fixture 2. Same local CAFI-center placement as fixture 1; parent fixture is already rotated 180 degrees. -->
  <joint name="fixture_2_to_cafi_lateral_target_frame" type="fixed">
    <parent link="rivet_fixture_2_link"/>
